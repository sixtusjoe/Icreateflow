<resources>
    <!-- Compose draws everything; this only sets the window before it does,
         so launch does not flash white on a dark phone. -->
    <style name="Theme.Companion" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
