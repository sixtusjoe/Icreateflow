[Unit]
Description=ICREATEFLOW FastAPI backend (gunicorn + uvicorn workers)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=icreateflow
Group=icreateflow
WorkingDirectory=/srv/icreateflow/backend
EnvironmentFile=/srv/icreateflow/backend/.env
ExecStart=/srv/icreateflow/venv/bin/gunicorn main:app \
    -k uvicorn.workers.UvicornWorker \
    -w 1 \
    -b 127.0.0.1:8100 \
    --timeout 300 \
    --graceful-timeout 30 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=5
# Resource limits — keep FFmpeg and web workers from overwhelming the box
CPUQuota=150%
MemoryMax=3G
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/srv/icreateflow

[Install]
WantedBy=multi-user.target
