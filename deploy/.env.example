# ICREATEFLOW production secrets.
# Copy to /srv/icreateflow/backend/.env on the VPS and chmod 600.
# NEVER commit the real .env to git.

# JWT signing key — generate with: openssl rand -hex 48
ICREATE_JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_48

# Postgres DSN — create a dedicated DB user for this app.
#   psql -c "CREATE ROLE icreateflow WITH LOGIN PASSWORD 'STRONG_PW';"
#   psql -c "CREATE DATABASE icreateflow OWNER icreateflow;"
ICREATE_DB_DSN=postgresql+asyncpg://icreateflow:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/icreateflow

# Anthropic + Replicate are read from the `settings` table (admin panel) — leave blank here.
# ANTHROPIC_API_KEY=
# REPLICATE_API_TOKEN=
