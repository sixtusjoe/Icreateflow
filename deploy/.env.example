# ICREATEFLOW production secrets.
# Copy to /srv/icreateflow/backend/.env on the VPS and chmod 600.
# NEVER commit the real .env to git.

# JWT signing key — generate with: openssl rand -hex 48
ICREATE_JWT_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_48

# Postgres DSN — create a dedicated DB user for this app.
#   psql -c "CREATE ROLE icreateflow WITH LOGIN PASSWORD 'STRONG_PW';"
#   psql -c "CREATE DATABASE icreateflow OWNER icreateflow;"
ICREATE_DB_DSN=postgresql+asyncpg://icreateflow:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/icreateflow

# Anthropic + Replicate are read from the `settings` table (admin panel) — leave blank here.
# ANTHROPIC_API_KEY=
# REPLICATE_API_TOKEN=

# --- Outreach ---
# Encrypts stored sending-account browser sessions. Optional: falls back to
# ICREATE_JWT_SECRET when unset. Set it to rotate session encryption
# independently of JWTs — note that rotating either one makes existing
# stored sessions unreadable, and those accounts must be re-authorized.
#   openssl rand -hex 48
# ICREATE_OUTREACH_SECRET=

# Run the Playwright driver with a visible browser (debugging only).
# ICREATE_OUTREACH_HEADLESS=0
# Per-navigation timeout for the browser driver, in milliseconds.
# ICREATE_OUTREACH_TIMEOUT_MS=30000
# Where the browser driver drops a screenshot when it cannot verify a send.
# Relative to the backend directory. Set to "" to disable.
# ICREATE_OUTREACH_DEBUG_DIR=outreach-debug
